# Copy to .env.local and fill in. `.env*.local` is gitignored — real values
# never belong in the repo.
#
#   cp .env.example .env.local        # macOS / Linux
#   Copy-Item .env.example .env.local # PowerShell

# Postgres. Use a database you don't mind losing — running the seed or the
# setup endpoint against it is destructive. On Neon, make a branch of the
# production database rather than pointing at production itself.
# On Neon use the pooled (-pooler) connection string.
DATABASE_URL=postgres://user:password@host/database

# Signs the session cookie. Any random string of 16+ characters. A different
# value here from production just means production's cookies won't validate
# locally, which is what you want.
SESSION_SECRET=change-me-to-something-random

# Optional. Real 15-minute-delayed quotes from finnhub.io — the free tier is
# enough. Leave it unset to run on the deterministic simulated feed, which is
# usually what you want locally.
# FINNHUB_API_KEY=

# Optional. Enables POST /api/setup, which creates the tables and loads the
# tradable universe. Unset means the endpoint refuses to run.
SETUP_TOKEN=local-setup
